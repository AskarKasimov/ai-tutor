# Use a long random alphanumeric value (URL-safe because it is used in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_PORT=5432
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
STT_URL=http://10.100.30.83:8000/transcribe
TTS_URL=http://10.100.30.83:8001/synthesize
ASSESSMENT_BASE_URL=http://10.100.10.105:30245/v1
ASSESSMENT_MODEL=gpt-oss-120b
ASSESSMENT_TIMEOUT=90s
PROCESSING_TIMEOUT=120s
LISTEN_ADDRESS=:8002
MAX_UPLOAD_BYTES=26214400

# Development only: enable Swagger UI at /docs/.
COMPOSE_PROFILES=swagger

# Frontend (Vite dev and Docker build)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8002
