# Use a long random alphanumeric value (URL-safe because it is used in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_PORT=5432
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
STT_URL=http://stt.example.internal:8000/transcribe/longform
TTS_URL=http://tts.example.internal:8001/synthesize
PROCESSING_TIMEOUT=120s
AUTH_RATE_LIMIT=30

# Development only: uncomment to enable Swagger UI at /docs/.
# COMPOSE_PROFILES=swagger

# Frontend (Vite dev and Docker build)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8002
