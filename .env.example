# PostgreSQL
# Use a long random alphanumeric password; it is included in BACKEND_DATABASE_URL.
DB_PASSWORD=replace-with-a-long-random-value
DB_PORT=5432

# Backend
# Адреса и параметры моделей обязательны.
BACKEND_LISTEN_ADDRESS=:8002
BACKEND_STT_URL=http://10.100.30.83:8000/transcribe
BACKEND_TTS_URL=http://10.100.30.83:8001/synthesize
BACKEND_TTS_SEED=510
BACKEND_TTS_CFG_VALUE=2.0
BACKEND_TTS_INFERENCE_TIMESTEPS=20
BACKEND_VOICE_TIMEOUT=120s
BACKEND_MAX_UPLOAD_BYTES=26214400
# Course materials are stored in private S3-compatible storage.
BACKEND_S3_ENDPOINT=http://s3:9000
BACKEND_S3_REGION=us-east-1
BACKEND_S3_BUCKET=task-audio
BACKEND_S3_PATH_STYLE=true
BACKEND_S3_TIMEOUT=30s
BACKEND_S3_CREATE_BUCKET=true
BACKEND_COURSE_GRAPH_URL=http://course-graph:8000
# Used by the optional local RustFS service. Set unique values for deployments.
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-random-secret-key
S3_PORT=9000
S3_LOCAL_ENABLED=true
# Optional backend Swagger container: swagger enables it; empty disables it.
COMPOSE_PROFILES=swagger

# HTTPS proxy
PROXY_HTTPS_BIND=127.0.0.1
PROXY_HTTPS_PORT=8443

# Frontend (Vite dev and Docker build)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8002

# Override backend's default db:5432 connection when needed.
# BACKEND_DATABASE_URL=postgres://ai_tutor:password@db:5432/ai_tutor?sslmode=disable
