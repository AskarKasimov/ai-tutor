# Copy to .env before ./prod.sh; replace the DB password and model addresses.
# PostgreSQL
# Use a long random alphanumeric password; it is included in BACKEND_DATABASE_URL.
DB_PASSWORD=replace-with-a-long-random-value
DB_PORT=5432

# Backend
# Адреса и параметры моделей обязательны.
BACKEND_LISTEN_ADDRESS=:8002
BACKEND_STT_URL=http://10.100.30.83:8000/transcribe
BACKEND_TTS_URL=http://10.100.30.83:8001/synthesize
BACKEND_TTS_SEED=510
BACKEND_TTS_CFG_VALUE=2.0
BACKEND_TTS_INFERENCE_TIMESTEPS=20
BACKEND_VOICE_TIMEOUT=120s
BACKEND_MAX_UPLOAD_BYTES=26214400
# Course materials are stored in private S3-compatible storage.
BACKEND_S3_ENDPOINT=https://objects.example.invalid
BACKEND_S3_REGION=us-east-1
BACKEND_S3_BUCKET=task-audio
BACKEND_S3_PATH_STYLE=true
BACKEND_S3_TIMEOUT=30s
BACKEND_S3_CREATE_BUCKET=false
BACKEND_COURSE_GRAPH_URL=http://course-graph:8000
# Overall HTTP timeout of course-graph calls; 0s means none (long OCR and topic
# extraction are bounded by the worker lease).
BACKEND_COURSE_GRAPH_TIMEOUT=0s
# gRPC address of the LLM gateway for course-graph cleaning, topics and links.
COURSE_GRAPH_LLM_GATEWAY_ADDR=llm-gateway:8011
# gRPC address of the LLM gateway (the gateway Compose profile runs it).
BACKEND_LLM_GATEWAY_ADDR=llm-gateway:8011
BACKEND_LLM_TIMEOUT=120s
# Graph used for courses without a stored graph; empty disables the fallback.
BACKEND_GEEK_GRAPH_FIXTURE=/fixtures/intro-to-ai.weeks-1-2.ru.graph.json
# Stop a diagnostic after that many questions and followups (rephrases do not
# count); topics covering more of the graph are asked first. 0 means no limit.
BACKEND_GEEK_MAX_QUESTIONS=8
# Used by the optional local RustFS service. Set unique values for deployments.
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-random-secret-key
S3_PORT=9000
S3_LOCAL_ENABLED=false
# Optional backend Swagger container: swagger enables it; empty disables it.
COMPOSE_PROFILES=

# HTTPS proxy
PROXY_HTTPS_BIND=0.0.0.0
PROXY_HTTPS_PORT=443

# Frontend (Docker build)
VITE_API_BASE_URL=/api/v1

# Override backend's default db:5432 connection when needed.
# BACKEND_DATABASE_URL=postgres://ai_tutor:password@db:5432/ai_tutor?sslmode=disable
