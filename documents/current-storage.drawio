        <mxCell id="browserArea" value="БРАУЗЕР · ПАМЯТЬ ВКЛАДКИ, НЕ POSTGRESQL" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=16;spacingLeft=20;arcSize=3;fillColor=#FFF7E9;strokeColor=#E9CA83;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#A46B10;" vertex="1" parent="1"><mxGeometry x="40" y="1115" width="1920" height="360" as="geometry" /></mxCell>
        <mxCell id="frontend_session" value="TrainerSession · Map&lt;userId, session&gt;&#xa;────────────────────────────&#xa;id, userId, currentAssignmentId&#xa;tasks: SessionTask[] (7 заданий)&#xa;answers: SessionAnswer[]&#xa;&#xa;SessionAnswer: assignmentId, transcript,&#xa;assessment {score 0|1|2, feedback[3]},&#xa;submittedAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#D99A32;strokeWidth=2;fontFamily=Courier New;fontSize=14;fontColor=#18372B;" vertex="1" parent="1"><mxGeometry x="75" y="1180" width="540" height="245" as="geometry" /></mxCell>
        <mxCell id="frontend_tasks" value="Вопросы и варианты · исходный код&#xa;────────────────────────────&#xa;7 заданий: ключи текста, вариантов&#xa;и голосовой инструкции. Тексты — в i18n.&#xa;Это не записи из PostgreSQL.tasks." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#D99A32;strokeWidth=2;fontFamily=Courier New;fontSize=14;fontColor=#18372B;" vertex="1" parent="1"><mxGeometry x="650" y="1180" width="390" height="175" as="geometry" /></mxCell>
        <mxCell id="frontend_audio" value="Аудио ответов · Blob/Object URL&#xa;────────────────────────────&#xa;Сохраняется в памяти вкладки для&#xa;прослушивания завершённых ответов.&#xa;В БД аудиофайлов нет." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#D99A32;strokeWidth=2;fontFamily=Courier New;fontSize=14;fontColor=#18372B;" vertex="1" parent="1"><mxGeometry x="1080" y="1180" width="390" height="175" as="geometry" /></mxCell>
        <mxCell id="frontend_mock" value="Mock API · только VITE_API_MODE=mock&#xa;────────────────────────────&#xa;Демо-пользователь и Map расшифровок&#xa;тоже живут только в памяти браузера.&#xa;В real-режиме auth/STT/TTS/LLM идут в backend." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FFFFFF;strokeColor=#D99A32;strokeWidth=2;fontFamily=Courier New;fontSize=14;fontColor=#18372B;" vertex="1" parent="1"><mxGeometry x="1510" y="1180" width="410" height="175" as="geometry" /></mxCell>

        <mxCell id="footer" value="Таблицы для generation_runs, material_chunks, learning_sessions, task_assignments и assignment_responses созданы; backend использует только variant snapshot для сессии. Состояние диагностических сессий и ответы хранятся в памяти процесса. Backend использует SQLC-каталог и генерацию. При импорте CSV/XLSX активная карта целиком заменяется, исходные строки сохраняются." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=15;fillColor=#F5F7F6;strokeColor=#DCE6DF;fontFamily=Arial;fontSize=15;fontColor=#18372B;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="1920" height="82" as="geometry" /></mxCell>
