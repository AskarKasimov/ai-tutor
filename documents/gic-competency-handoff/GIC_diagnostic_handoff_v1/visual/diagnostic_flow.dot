digraph Flow {graph [rankdir=TB,bgcolor="white",fontname="DejaVu Sans",nodesep=0.35,ranksep=0.55];node [fontname="DejaVu Sans",style="rounded,filled",shape=box,fillcolor="#EEF4FB",color="#9DAFC2"]; edge [fontname="DejaVu Sans",color="#6E839B"];Start [label="Выбрать DG и непроверенную терминальную тему"]; Ask [label="Показать вопрос (или подкритерий интегрированного кейса)"]; Answer [label="Получить ответ и предметную оценку",shape=diamond,fillcolor="#FFF3DE"]; Pass [label="mastered_observed для этой темы",fillcolor="#DAF5E8"]; Fail [label="suspected_gap для этой темы",fillcolor="#FFEBE3"]; Uncertain [label="unknown / нужно уточнение",fillcolor="#F4F4F5"]; Prereq [label="Проверить непосредственные предпосылки
(без повторов) "]; Next [label="Следующая непроверенная тема / завершение"];Plan [label="План обучения: только prerequisite DAG
топологически от атомарных",fillcolor="#EDF2FF"];Start->Ask->Answer;Answer->Pass [label="pass"];Answer->Fail [label="fail"];Answer->Uncertain [label="uncertain"];Pass->Next;Fail->Prereq->Next;Uncertain->Next;Next->Ask [label="остались",constraint=false];Next->Plan [label="нет задач"]; }