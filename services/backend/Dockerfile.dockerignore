# The backend builds from the repository root; only its own sources and the
# shared contracts, common audio and voice test fixture sources are sent.
*
!services/backend/go.mod
!services/backend/go.sum
!services/backend/.air.toml
!services/backend/cmd
!services/backend/internal
!services/shared

!services/audio
!services/voice-gateway/go.mod
!services/voice-gateway/go.sum
!services/voice-gateway/internal
!services/voice-gateway/testkit
**/*_test.go
