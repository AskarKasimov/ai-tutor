:443 {
	tls /certs/server.pem /certs/server-key.pem
	log {
		output stdout
		format console
	}

	@docs path /docs /docs/*
	handle @docs {
		@swagger_enabled expression {env.COMPOSE_PROFILES}.matches('(^|,)swagger(,|$)')
		handle @swagger_enabled {
			redir /docs /docs/ 308
			reverse_proxy swagger:8080
		}
		respond 404
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		@vscode_origin header_regexp Origin ^(vscode-webview://[a-zA-Z0-9-]+|https://[a-zA-Z0-9-]+\.vscode-cdn\.net)$
		route @vscode_origin {
			header {
				Access-Control-Allow-Origin "{http.request.header.Origin}"
				Access-Control-Allow-Methods "GET, POST, OPTIONS"
				Access-Control-Allow-Headers "Content-Type"
				Access-Control-Allow-Credentials "true"
				+Vary Origin
			}
			@preflight method OPTIONS
			respond @preflight 204
		}
		uri strip_prefix /api/v1
		reverse_proxy api:8002
	}

	handle {
		reverse_proxy frontend:80
	}
}
